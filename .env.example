# Local development only. Do not copy production secrets into this file.
APCLRWA_ENV=development
APCLRWA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APCLRWA_DATA_DIR=./data
APCLRWA_DATABASE_PATH=./data/apclrwa.sqlite3
APCLRWA_SESSION_HOURS=12
APCLRWA_AUTH_ACCOUNT_LIMIT=5
APCLRWA_AUTH_IP_LIMIT=30
APCLRWA_AUTH_WINDOW_SECONDS=900

# Production requires APCLRWA_ENV=production, explicit HTTPS origins, and
# APCLRWA_COOKIE_SECURE=true. Configure those outside the repository.
